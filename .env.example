# 复制为 .env 后填写。不要把 .env 提交到 Git。

# 公网地址（ChatGPT 连接器填 ${PUBLIC_BASE_URL}/mcp）
PUBLIC_BASE_URL=https://memorybus.czczccc.space
# Caddy 用它自动申请 HTTPS 证书
DOMAIN=memorybus.czczccc.space

# 数据库（docker compose 内部地址，一般不用改；密码请改成随机值）
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://memorybus:change-me@db:5432/memorybus

# REST 入口（Muse 技能用）。生成：uv run memorybus token
MEMORYBUS_API_TOKEN=

# MCP 入口的 GitHub OAuth App（回调地址 ${PUBLIC_BASE_URL}/auth/callback）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 只有这些 GitHub 账号能登录，逗号分隔
ALLOWED_GITHUB_LOGINS=c1463693519-rgb
# 签发给 ChatGPT 的 token 的签名密钥，随机长字符串。生成：uv run memorybus token
JWT_SIGNING_KEY=

# Embedding（硅基流动，OpenAI 兼容接口）。留空时只用关键词搜索
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
# 建库后不要再改，改了需要重新计算所有向量
EMBEDDING_DIMENSIONS=1024
# embedding 接口超时（秒），超时后自动改用关键词搜索
EMBEDDING_TIMEOUT_SECONDS=10
